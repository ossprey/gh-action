{
    "name": "Ossprey",
    "image": "ghcr.io/ossprey/devcontainer:latest",
    "customizations": {
        "vscode": {
            "extensions": [
                "GitHub.copilot",
                "aaron-bond.better-comments",
                "github.vscode-github-actions",
                "timonwong.shellcheck",
                "foxundermoon.shell-format"
            ]
        }
    },
    "postStartCommand": "bash .devcontainer/startup.sh"
}
